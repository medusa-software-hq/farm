-- Mirror of the Flyway migrations for this table; SQLDelight verifies the queries
-- below against it at compile time, so the two must stay identical.
CREATE TABLE sessions (
  id              TEXT        NOT NULL PRIMARY KEY,
  installation_id BIGINT      NOT NULL,
  github_repo_id  BIGINT      NOT NULL,
  number          INTEGER     NOT NULL,
  repo_full_name  TEXT        NOT NULL DEFAULT '',
  title           TEXT        NOT NULL DEFAULT '',
  state           TEXT        NOT NULL,
  created_at      TIMESTAMPTZ NOT NULL,
  updated_at      TIMESTAMPTZ NOT NULL
);

-- Opens a session for an issue. Idempotent on the id so an activity retry never double-inserts.
create:
INSERT INTO sessions (
  id, installation_id, github_repo_id, number, repo_full_name, title, state, created_at, updated_at
) VALUES (:id, :installationId, :githubRepoId, :number, :repoFullName, :title, :state, now(), now())
ON CONFLICT (id) DO NOTHING;

-- Moves a session to a terminal state (completed or failed).
setState:
UPDATE sessions SET state = :state, updated_at = now() WHERE id = :id;

listForOrg:
SELECT s.id, s.installation_id, s.github_repo_id, s.number, s.repo_full_name, s.title, s.state,
       s.created_at, s.updated_at, pr.pr_number, pr.pr_url, pr.head_sha, pr.merged_at
FROM sessions s
LEFT JOIN session_pr pr ON pr.session_id = s.id
WHERE s.installation_id = :installationId
ORDER BY s.created_at;

get:
SELECT s.id, s.installation_id, s.github_repo_id, s.number, s.repo_full_name, s.title, s.state,
       s.created_at, s.updated_at, pr.pr_number, pr.pr_url, pr.head_sha, pr.merged_at
FROM sessions s
LEFT JOIN session_pr pr ON pr.session_id = s.id
WHERE s.id = :id;
