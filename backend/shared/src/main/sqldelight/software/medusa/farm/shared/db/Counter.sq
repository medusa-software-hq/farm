-- Mirror of the Flyway migration for this table; SQLDelight verifies the queries below
-- against it at compile time, so the two must stay identical.
CREATE TABLE counter (
  id    TEXT NOT NULL PRIMARY KEY,
  count INTEGER NOT NULL DEFAULT 0
);

selectCount:
SELECT count FROM counter WHERE id = ?;

adjustCount:
INSERT INTO counter (id, count) VALUES (?, ?)
ON CONFLICT (id) DO UPDATE SET count = counter.count + EXCLUDED.count
RETURNING count;
