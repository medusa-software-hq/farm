-- Mirror of the Flyway migrations for this table; SQLDelight verifies the queries below against it at
-- compile time, so the two must stay identical.
--
-- One agent run within a session. action_log is the AgentRunLog as JSON; outcome/cost/summary are
-- the run's metadata; a run is never recorded without its summary.
CREATE TABLE session_run (
  id          TEXT        NOT NULL PRIMARY KEY,
  session_id  TEXT        NOT NULL REFERENCES sessions(id),
  ordinal     INTEGER     NOT NULL,
  action_log  TEXT        NOT NULL,
  outcome     TEXT        NOT NULL,
  cost        TEXT,
  summary     TEXT        NOT NULL,
  created_at  TIMESTAMPTZ NOT NULL,
  UNIQUE (session_id, ordinal)
);

-- Records a run's action log, outcome and summary. Idempotent on (session_id, ordinal) so an
-- activity retry overwrites the run with the latest attempt rather than inserting a duplicate.
recordRun:
INSERT INTO session_run (id, session_id, ordinal, action_log, outcome, cost, summary, created_at)
VALUES (:id, :sessionId, :ordinal, :actionLog, :outcome, :cost, :summary, now())
ON CONFLICT (session_id, ordinal) DO UPDATE
SET action_log = excluded.action_log, outcome = excluded.outcome, cost = excluded.cost,
    summary = excluded.summary;

selectForSession:
SELECT ordinal, action_log, outcome, cost, summary, created_at
FROM session_run
WHERE session_id = :sessionId
ORDER BY ordinal;
