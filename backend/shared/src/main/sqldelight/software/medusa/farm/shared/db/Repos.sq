-- Mirror of the Flyway migration for this table; SQLDelight verifies the queries
-- below against it at compile time, so the two must stay identical.
CREATE TABLE repos (
  github_repo_id  BIGINT      NOT NULL,
  installation_id BIGINT      NOT NULL,
  full_name       TEXT        NOT NULL,
  name            TEXT        NOT NULL,
  private         BOOLEAN     NOT NULL,
  default_branch  TEXT        NOT NULL,
  last_seen_at    TIMESTAMPTZ NOT NULL,
  orphaned_at     TIMESTAMPTZ,
  PRIMARY KEY (installation_id, github_repo_id)
);

-- Records a fetched repo as seen now and active; reactivates it if it was orphaned.
upsert:
INSERT INTO repos (
  github_repo_id, installation_id, full_name, name, private, default_branch, last_seen_at, orphaned_at
) VALUES (:githubRepoId, :installationId, :fullName, :name, :isPrivate, :defaultBranch, now(), NULL)
ON CONFLICT (installation_id, github_repo_id) DO UPDATE SET
  full_name = EXCLUDED.full_name,
  name = EXCLUDED.name,
  private = EXCLUDED.private,
  default_branch = EXCLUDED.default_branch,
  last_seen_at = now(),
  orphaned_at = NULL;

-- Soft-orphans everything this installation's sync did not touch: rows last seen before the sync
-- started (the watermark) that are still active. Rows upserted in the same sync have last_seen_at at
-- or after the watermark, so they survive.
orphanMissing:
UPDATE repos SET orphaned_at = now()
WHERE installation_id = :installationId AND last_seen_at < :syncStartedAt AND orphaned_at IS NULL;

listActive:
SELECT github_repo_id, installation_id, full_name, name, private AS isPrivate, default_branch
FROM repos
WHERE installation_id = :installationId AND orphaned_at IS NULL
ORDER BY full_name;
