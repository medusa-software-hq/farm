-- Mirror of the Flyway migration for this table; SQLDelight verifies the queries
-- below against it at compile time, so the two must stay identical.
CREATE TABLE fibonacci (
  n           INTEGER   NOT NULL PRIMARY KEY,
  value       TEXT      NOT NULL,
  computed_at TIMESTAMP NOT NULL DEFAULT now()
);

record:
INSERT INTO fibonacci (n, value) VALUES (?, ?);

highestIndex:
SELECT n FROM fibonacci ORDER BY n DESC LIMIT 1;

selectAll:
SELECT n, value FROM fibonacci ORDER BY n;
