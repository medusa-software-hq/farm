-- Mirror of the API-owned Flyway migration, for SQLDelight's compile-time query verification only;
-- the two must stay identical. The API owns the runtime schema; the worker only writes rows.
CREATE TABLE fibonacci (
  n           INTEGER   NOT NULL PRIMARY KEY,
  value       TEXT      NOT NULL,
  computed_at TIMESTAMP NOT NULL DEFAULT now()
);

record:
INSERT INTO fibonacci (n, value) VALUES (?, ?);

highestIndex:
SELECT n FROM fibonacci ORDER BY n DESC LIMIT 1;
